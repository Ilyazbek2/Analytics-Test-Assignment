# ============================================================
# ANALYTICS TEST ASSIGNMENT
# Audience Analytics & A/B Testing
# ============================================================

# Import libraries
import pandas as pd
import numpy as np
from scipy import stats
import matplotlib.pyplot as plt


# ============================================================
# 1. LOAD AUDIENCE DATA
# ============================================================

# Load the audience dataset
audience = pd.read_csv("audience_data.csv")

# Convert date column to datetime
audience["date"] = pd.to_datetime(audience["date"])

# Display basic information
print("AUDIENCE DATA")
print("-" * 50)
print("Rows:", audience.shape[0])
print("Columns:", audience.shape[1])
print()

print(audience.head())


# ============================================================
# 2. MAU — MONTHLY ACTIVE USERS
# ============================================================

# Select November 2023
november = audience[
    (audience["date"] >= "2023-11-01") &
    (audience["date"] < "2023-12-01")
]

# Count unique users
mau = november["user_id"].nunique()

print("\nMAU")
print("-" * 50)
print("MAU:", mau)


# ============================================================
# 3. DAU — DAILY ACTIVE USERS
# ============================================================

# Select November 1, 2023
day_1 = audience[
    audience["date"] == "2023-11-01"
]

# Count unique users
dau = day_1["user_id"].nunique()

print("\nDAU")
print("-" * 50)
print("DAU:", dau)


# ============================================================
# 4. AVERAGE DAU
# ============================================================

# Calculate unique active users for each day
daily_dau = (
    audience.groupby("date")["user_id"]
    .nunique()
)

# Calculate average daily active users
average_dau = daily_dau.mean()

print("\nAVERAGE DAU")
print("-" * 50)
print("Average DAU:", round(average_dau))


# ============================================================
# 5. D1 RETENTION
# ============================================================

# Users active on November 1
day_1_users = set(
    audience.loc[
        audience["date"] == "2023-11-01",
        "user_id"
    ]
)

# Users active on November 2
day_2_users = set(
    audience.loc[
        audience["date"] == "2023-11-02",
        "user_id"
    ]
)

# Find users who returned the next day
returned_users = day_1_users.intersection(day_2_users)

# Calculate D1 retention
retention_d1 = (
    len(returned_users) / len(day_1_users)
) * 100

print("\nD1 RETENTION")
print("-" * 50)
print("D1 Retention:", round(retention_d1, 1), "%")


# ============================================================
# 6. CONVERSION TO AD VIEW
# ============================================================

# Total unique users in November
total_users = november["user_id"].nunique()

# Users who viewed at least one advert
users_viewed_ads = november.loc[
    november["view_adverts"] > 0,
    "user_id"
].nunique()

# Calculate conversion rate
conversion_rate = (
    users_viewed_ads / total_users
) * 100

print("\nCONVERSION TO AD VIEW")
print("-" * 50)
print("Conversion Rate:", round(conversion_rate, 1), "%")


# ============================================================
# 7. AVERAGE VIEWED ADVERTS PER USER
# ============================================================

# Total number of viewed adverts
total_views = november["view_adverts"].sum()

# Calculate average per unique user
average_views = (
    total_views / total_users
)

print("\nAVERAGE VIEWED ADVERTS")
print("-" * 50)
print(
    "Average Viewed Adverts:",
    round(average_views, 2)
)


# ============================================================
# 8. LOAD A/B TEST DATA
# ============================================================

# Load A/B test dataset
ab = pd.read_csv("ab_tests.csv")

print("\nA/B TEST DATA")
print("-" * 50)
print("Rows:", ab.shape[0])
print("Columns:", ab.shape[1])
print()

print(ab.head())


# ============================================================
# 9. ARPU
# ============================================================

# ARPU = Average Revenue Per User
# Calculate ARPU for each experiment group

arpu = (
    ab.groupby("experiment_group")["revenue"]
    .mean()
)

print("\nARPU")
print("-" * 50)
print(arpu)


# ============================================================
# 10. COMPARE ARPU
# ============================================================

# Get ARPU for control and test groups
control_arpu = arpu["control"]
test_arpu = arpu["test"]

# Calculate difference
arpu_difference = test_arpu - control_arpu

print("\nARPU COMPARISON")
print("-" * 50)
print("Control ARPU:", control_arpu)
print("Test ARPU:", test_arpu)
print("Difference:", arpu_difference)


# ============================================================
# 11. T-TEST
# ============================================================

# Select revenue for each group
control = ab.loc[
    ab["experiment_group"] == "control",
    "revenue"
]

test = ab.loc[
    ab["experiment_group"] == "test",
    "revenue"
]

# Perform independent samples t-test
t_stat, p_value = stats.ttest_ind(
    control,
    test,
    equal_var=False
)

print("\nT-TEST")
print("-" * 50)
print("T-statistic:", t_stat)
print("P-value:", p_value)


# ============================================================
# 12. HYPOTHESIS TESTING
# ============================================================

# Significance level
alpha = 0.05

print("\nHYPOTHESIS TEST")
print("-" * 50)

if p_value < alpha:
    print("The difference is statistically significant.")
else:
    print("The difference is not statistically significant.")


# ============================================================
# 13. REVENUE DISTRIBUTION
# ============================================================

# Visualize revenue distribution
# for control and test groups

plt.figure(figsize=(10, 5))

plt.hist(
    control,
    bins=30,
    alpha=0.5,
    label="Control"
)

plt.hist(
    test,
    bins=30,
    alpha=0.5,
    label="Test"
)

plt.xlabel("Revenue")
plt.ylabel("Number of Users")
plt.title("Revenue Distribution by Experiment Group")
plt.legend()
plt.show()


# ============================================================
# 14. FINAL SUMMARY
# ============================================================

print("\nFINAL SUMMARY")
print("=" * 50)

print("MAU:", mau)
print("DAU:", dau)
print("Average DAU:", round(average_dau))
print("D1 Retention:", round(retention_d1, 1), "%")
print("Conversion Rate:", round(conversion_rate, 1), "%")
print("Average Viewed Adverts:", round(average_views, 2))

print("\nA/B TEST")
print("-" * 50)
print("Control ARPU:", control_arpu)
print("Test ARPU:", test_arpu)
print("ARPU Difference:", arpu_difference)
print("T-statistic:", t_stat)
print("P-value:", p_value)
